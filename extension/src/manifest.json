{
  "manifest_version": 3,
  "name": "ScamShield",
  "version": "0.2.2",
  "description": "Warns you about scam messages in WhatsApp, LinkedIn, Google Messages, Telegram and Discord, and about fake websites, using a fine-tuned AI model.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "ScamShield", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://aryag1507--scamshield-api-web.us-east.modal.run/*"],
  "optional_host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.linkedin.com/*",
    "https://messages.google.com/*",
    "https://web.telegram.org/*",
    "https://discord.com/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "<all_urls>"
  ]
}
